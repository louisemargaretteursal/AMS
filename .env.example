# SSS Toledo Operations Dashboard Environment Configuration

# Server Port (default: 3002)
PORT=3002

# Secret key for HMAC-SHA256 session token signing
APP_SESSION_SECRET=sss-local-dev-secret-change-me

# =========================================================================
# PostgreSQL Database Configuration
# =========================================================================
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# Examples:
# 1. Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sss_toledo
#
# 2. Render / Railway / Cloud PostgreSQL:
# DATABASE_URL=postgresql://postgres:your-db-password@db.render.com:5432/sss_toledo
#
# Note: If DATABASE_URL is left unset, the system will use local development SQLite fallback.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sss_toledo
